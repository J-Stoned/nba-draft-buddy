{
  "name": "nba-draft-buddy",
  "version": "1.0.0",
  "private": true,
  "description": "Elite fantasy basketball draft assistant with AI-powered recommendations",
  "keywords": ["fantasy", "basketball", "draft", "nba", "analytics"],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:watch": "turbo run test -- --watch",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint",
    "typecheck": "turbo run type-check",
    "clean": "turbo run clean",
    "db:migrate": "cd infrastructure/supabase && supabase db push",
    "db:seed": "cd infrastructure/supabase && supabase db seed"
  },
  "devDependencies": {
    "turbo": "^1.12.0",
    "typescript": "^5.3.0",
    "@types/node": "^20.11.0",
    "prettier": "^3.2.0",
    "eslint": "^8.56.0"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}